clc;
clear;
close all;

%% TOUCHSTONE BASED SECURITY SYSTEM

disp('======================================');
disp(' TOUCHSTONE SECURITY SYSTEM');
disp('======================================');

%% User Input

% Enter the stored password
password = input('Enter the stored password (e.g. [1 3 2 4]): ');

% Enter the user sequence
entered = input('Enter the touch sequence (e.g. [1 3 2 4]): ');

%% Sampling parameters

fs = 1000; % Sampling frequency
touch_time = 0.5; % Duration of each touch
gap_time = 0.5; % Gap between touches

samples_touch = round(fs * touch_time);
samples_gap = round(fs * gap_time);

%% Generate Touch Signal

signal = [];

for i = 1:length(entered)

    % Generate touch pulse
    pulse = entered(i) * ones(1, samples_touch);

    % Gap between touches
    gap = zeros(1, samples_gap);

    signal = [signal pulse gap];

end

%% Time axis

t = (0:length(signal)-1)/fs;

%% Add Noise

noise = 0.3 * randn(size(signal));

noisy_signal = signal + noise;

%% Filtering

window = 50;

filtered_signal = movmean(noisy_signal, window);

%% Display Password Information

disp(' ');
disp('--------------------------------------');
disp(['Stored Password : ', num2str(password)]);
disp(['Entered Sequence : ', num2str(entered)]);
disp('--------------------------------------');

%% Compare Password

if isequal(password, entered)

    disp('ACCESS GRANTED');

else

    disp('ACCESS DENIED');

end

%% Plot Signals

figure;

subplot(3,1,1);
plot(t, signal);
grid on;
xlabel('Time (seconds)');
ylabel('Amplitude');
title('Original Touch Signal');

subplot(3,1,2);
plot(t, noisy_signal);
grid on;
xlabel('Time (seconds)');
ylabel('Amplitude');
title('Noisy Touch Signal');

subplot(3,1,3);
plot(t, filtered_signal);
grid on;
xlabel('Time (seconds)');
ylabel('Amplitude');
title('Filtered Touch Signal');


